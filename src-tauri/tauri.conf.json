{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zastava",
  "version": "1.0.5",
  "identifier": "io.zastava.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zastava",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "alert-popup",
        "title": "Zastava Alert",
        "width": 480,
        "height": 440,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-green.png",
      "tooltip": "Застава — Сетевой шлюз для работы с ИИ"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
